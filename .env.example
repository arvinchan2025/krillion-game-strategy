# Public site origin. Set this to your real production domain before deployment.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Optional AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=

# Set to "true" only after your AdSense account/site is approved and the ad unit is configured.
NEXT_PUBLIC_ADSENSE_ENABLED=false
